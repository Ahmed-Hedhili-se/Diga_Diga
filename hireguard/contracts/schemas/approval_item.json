{
  "$defs": {
    "ApprovalKind": {
      "enum": [
        "email_send",
        "interview_booking",
        "status_change",
        "shortlist_commit",
        "document_release",
        "held_email_release",
        "leave_request",
        "offer"
      ],
      "title": "ApprovalKind",
      "type": "string"
    },
    "ApprovalStatus": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "executed"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "Decision": {
      "properties": {
        "user_id": {
          "title": "User Id",
          "type": "string"
        },
        "decision": {
          "enum": [
            "approve",
            "reject"
          ],
          "title": "Decision",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "decision",
        "at"
      ],
      "title": "Decision",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ApprovalKind"
    },
    "risk": {
      "maximum": 100,
      "minimum": 0,
      "title": "Risk",
      "type": "integer"
    },
    "risk_level": {
      "enum": [
        "routine",
        "high"
      ],
      "title": "Risk Level",
      "type": "string"
    },
    "batch_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Batch Id"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "payload": {
      "title": "Payload",
      "type": "object"
    },
    "diff": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Diff"
    },
    "required_approvals": {
      "default": 1,
      "maximum": 2,
      "minimum": 1,
      "title": "Required Approvals",
      "type": "integer"
    },
    "decisions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Decision"
      },
      "title": "Decisions",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ApprovalStatus",
      "default": "pending"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "title": "Created By",
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "risk",
    "risk_level",
    "title",
    "payload",
    "created_at",
    "created_by"
  ],
  "title": "ApprovalItem",
  "type": "object"
}