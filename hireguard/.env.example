# Copy to .env. Never commit .env.
HG_DB_PATH=backend/hireguard.db
HG_UPLOAD_DIR=backend/uploads

# Comma-separated: one URL per laptop GPU (load-balanced round robin)
HG_OLLAMA_URLS=http://localhost:11434
HG_OLLAMA_MODEL=qwen3:8b

# Groq fallback: FICTIONAL DATA ONLY. Off by default.
HG_GROQ_FALLBACK=0
GROQ_API_KEY=
HG_GROQ_MODEL=qwen/qwen3-32b

# Prompt Guard 2 (needs `pip install -r backend/requirements-ml.txt`)
HG_PROMPT_GUARD=0

HG_SESSION_TTL_MIN=480
HG_COOKIE_SECURE=0
HG_CORS_ORIGINS=http://localhost:5173
HG_MAX_UPLOAD_BYTES=5242880
HG_MAX_PDF_PAGES=6
HG_CANARY_EVERY=20

# Email extraction: "model" (default, Ollama) or "ground_truth" (offline demo: reads data/emails/labels.json, NOT a model run)
HG_EXTRACT_MODE=model
