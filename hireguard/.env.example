# Copy to .env. Never commit .env.
HG_DB_PATH=backend/hireguard.db
HG_UPLOAD_DIR=backend/uploads

# Comma-separated: one URL per GPU, local or a Modal endpoint (load-balanced round robin).
# HG_OLLAMA_URLS is still read when HG_OLLAMA_HOSTS is unset.
HG_OLLAMA_HOSTS=http://localhost:11434
HG_OLLAMA_MODEL=qwen3:8b
# Modal proxy auth token (Modal dashboard > Settings > Proxy Auth Tokens). Leave empty for a local Ollama.
HG_OLLAMA_MODAL_KEY=
HG_OLLAMA_MODAL_SECRET=
# Seconds per model call; one retry on 502/503/504 or timeout (a Modal cold start takes 1-3 minutes)
HG_LLM_TIMEOUT=120

# Groq fallback: FICTIONAL DATA ONLY. Off by default.
# Which model reads CVs: ollama (local or Modal GPU) or gemini (Google cloud: CV text is sent to Google,
# use it for fictional or consented CVs only). Put the real key in .env, never in the repo
HG_LLM_PROVIDER=ollama
GEMINI_API_KEY=
# One model, or several separated by commas: the next is tried when the first one's daily quota is used up
# (the free tier allows about 20 requests per model per day)
HG_GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash

HG_GROQ_FALLBACK=0
GROQ_API_KEY=
HG_GROQ_MODEL=qwen/qwen3-32b

# Prompt Guard 2 (needs `pip install -r backend/requirements-ml.txt`)
HG_PROMPT_GUARD=0

HG_SESSION_TTL_MIN=480
HG_COOKIE_SECURE=0
HG_CORS_ORIGINS=http://localhost:5173
HG_MAX_UPLOAD_BYTES=5242880
HG_MAX_PDF_PAGES=6
HG_CANARY_EVERY=20

# Email extraction: "model" (default, Ollama) or "ground_truth" (offline demo: reads data/emails/labels.json, NOT a model run)
HG_EXTRACT_MODE=model

# Odoo ERP connector (docs/erp_odoo.md). Off by default: with 0 the app behaves exactly as without it.
HG_ODOO_ENABLED=0
HG_ODOO_URL=http://localhost:8069
HG_ODOO_DB=hireguard
# Bot user with the Recruitment / Officer group only. Use an API key (Odoo > Preferences > Account Security).
HG_ODOO_USER=hireguard-bot@example.tn
HG_ODOO_API_KEY=
HG_ODOO_TIMEOUT_S=10
# Stage that an approved shortlist moves applicants to
HG_ODOO_SHORTLIST_STAGE=Shortlisted (HireGuard)
# Calendar whose busy events block interview slots (empty = the bot user)
HG_ODOO_RECRUITER_LOGIN=
# 1 = approved emails are sent by Odoo to the applicant; 0 = only logged as an internal note
HG_ODOO_SEND_EMAIL=0

# Auth and web security (P4, docs/security_auth.md)
HG_SESSION_IDLE_MIN=30
HG_LOGIN_IP_MAX_FAILED=20
# Login attempts (successful or not) per IP per minute. Raise it when many staff share one NAT address
HG_LOGIN_RATE_PER_MIN=10
# 0 in production: removes /api/docs and /api/openapi.json (pentest O1)
HG_API_DOCS=1
# Reverse proxies allowed to set X-Forwarded-For (IPs or CIDRs, comma-separated). Empty = ignore the header (pentest O2)
HG_TRUSTED_PROXIES=

# Production mode: the server REFUSES TO START unless HG_COOKIE_SECURE=1, HG_API_DOCS=0, https-only HG_CORS_ORIGINS,
# HG_PARSE_ISOLATION=1, and no cloud model provider (gemini / groq) without HG_ALLOW_CLOUD_LLM=1. See docs/security_hardening.md.
HG_ENV=development
# Cloud providers send CV text to a third party. Fictional or consented data only.
HG_ALLOW_CLOUD_LLM=0
# Parse uploaded PDFs in a separate, time-limited process (default: on in production, off in development)
# HG_PARSE_ISOLATION=1
# HG_PARSE_TIMEOUT_S=20
# HG_PARSE_MEMORY_MB=1024
# HG_PARSE_WORKERS=2
